---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { title, description, pubDate, tags } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${title} — Astro Field`} description={description}>
  <div class="page">
    <Header current="blog" />
    <main>
      <article>
        <header class="post-header">
          <div class="meta">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {tags && (
              <div class="tags">
                {tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
          <h1>{title}</h1>
          <p class="description">{description}</p>
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
  </div>
</Layout>

<style>
  /* 左端はヘッダーに揃え、行長だけ詰める */
  main > :global(*) {
    max-width: var(--measure);
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--ore);
    margin-bottom: 0.75rem;
  }

  .tags {
    display: flex;
    gap: 0.75rem;
  }

  h1 {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .description {
    color: var(--ore);
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 2rem 0 0.5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
  }

  .prose :global(blockquote) {
    padding-left: 1rem;
    border-left: 4px solid var(--rule);
    color: var(--ore);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .prose :global(code) {
    font-family: var(--font-fixed);
  }

  .prose :global(p code),
  .prose :global(li code) {
    font-size: 0.9em;
    padding: 0.05em 0.3em;
    background: rgba(29, 35, 39, 0.07);
    border-radius: 3px;
  }
</style>
