---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { title, description, pubDate, tags } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${title} — Astro Field`} description={description}>
  <div class="page">
    <Header current="blog" />
    <main>
      <article>
        <header class="post-header">
          <div class="meta">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {tags && (
              <div class="tags">
                {tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
          <h1>{title}</h1>
          <p class="description">{description}</p>
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    padding: 1.5rem;
  }

  main {
    max-width: 720px;
    margin: 3rem auto 0;
    padding: 0 1rem;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  time {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .description {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .prose {
    color: #d4d4d8;
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--text);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(a) {
    color: var(--accent-from);
    text-decoration: underline;
    text-decoration-color: rgba(168, 85, 247, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent-from);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--accent-from);
    background: rgba(168, 85, 247, 0.06);
    border-radius: var(--radius);
    color: var(--muted);
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }

  .prose :global(pre) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .prose :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875em;
  }

  .prose :global(p code),
  .prose :global(li code) {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.1em 0.4em;
  }
</style>
