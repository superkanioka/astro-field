---
import { url } from '../utils/url';
import { SITE_NAME } from '../site';
interface Props {
  current?: 'home' | 'minecraft' | 'superk';
}
const { current } = Astro.props;

const links = [
  { key: 'superk', href: url('/superk'), label: 'スーパーカミオカンデ' },
  { key: 'minecraft', href: url('/minecraft'), label: 'マイクラサーバー' },
] as const;
---

<header class="site-header">
  {current === 'home' ? (
    <span class="logo">{SITE_NAME}</span>
  ) : (
    <a href={url('/')} class="logo">{SITE_NAME}</a>
  )}
  <nav aria-label="ページ">
    {links.map(link => (
      <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    max-width: var(--wide);
    margin: 0 auto 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2rem;
  }

  .logo {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--ore);
    text-decoration: none;
    padding-bottom: 0.125rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--ink);
  }

  /* いま見ているページは琥珀の下線で示す */
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--amber);
  }
</style>
