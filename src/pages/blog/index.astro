---
import { url } from '../../utils/url';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog — Astro Field" description="Astro Field のブログ記事一覧。">
  <div class="page">
    <Header current="blog" />
    <main>
      <h1>Blog</h1>
      <ul>
        {posts.map(post => (
          <li>
            <a href={url(`/blog/${post.id}`)} class="card">
              <div class="card-inner">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="card-footer">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {post.data.tags && (
                    <div class="tags">
                      {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                    </div>
                  )}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </div>
</Layout>

<style>
  /* 左端はヘッダーに揃え、行長だけ詰める */
  main > :global(*) {
    max-width: var(--measure);
  }

  h1 {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);
    font-weight: 700;
    margin-bottom: 2rem;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 2rem;
  }

  .card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  h2 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--amber-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .card:hover h2 {
    text-decoration-thickness: 2px;
  }

  p {
    color: var(--ink);
    margin: 0.25rem 0;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--ore);
  }

  .tags {
    display: flex;
    gap: 0.75rem;
  }
</style>
