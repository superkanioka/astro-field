---
import { url } from '../../utils/url';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog — Astro Field" description="Astro Field のブログ記事一覧。">
  <div class="page">
    <Header current="blog" />
    <main>
      <h1>Blog</h1>
      <ul>
        {posts.map(post => (
          <li>
            <a href={url(`/blog/${post.id}`)} class="card">
              <div class="card-inner">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="card-footer">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {post.data.tags && (
                    <div class="tags">
                      {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                    </div>
                  )}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    padding: 1.5rem;
  }

  main {
    max-width: 720px;
    margin: 3rem auto 0;
    padding: 0 1rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, var(--text), var(--accent-from));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: background 0.2s, border-color 0.2s;
  }

  .card:hover {
    background: var(--surface-hover);
    border-color: rgba(168, 85, 247, 0.3);
  }

  .card-inner {
    padding: 1.5rem;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--text);
  }

  p {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  time {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
</style>
