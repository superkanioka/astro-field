---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog">
  <nav>
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
  </nav>
  <main>
    <h1>Blog</h1>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id}`}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eee;
  }
  nav a {
    color: #555;
    text-decoration: none;
  }
  nav a:hover { color: #000; }
  main {
    font-family: system-ui, sans-serif;
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    color: #222;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  li a {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    transition: border-color 0.2s;
  }
  li a:hover {
    border-color: #aaa;
  }
  h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
  }
  p {
    margin: 0 0 0.25rem;
    color: #555;
    font-size: 0.95rem;
  }
  time {
    font-size: 0.85rem;
    color: #888;
  }
</style>
