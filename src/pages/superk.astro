---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SuperKCylinder from '../components/SuperKCylinder.astro';
import { pageTitle } from '../site';

// 神岡宇宙素粒子研究施設が公開しているイベントディスプレイ画像。
// 元ページ (realtimemonitor/) も 10 秒ごとに再読み込みしているので、同じ間隔で更新する。
const source = {
  image: 'https://www-sk.icrr.u-tokyo.ac.jp/realtimemonitor/skev.gif',
  page: 'https://www-sk.icrr.u-tokyo.ac.jp/realtimemonitor/',
  home: 'https://www-sk.icrr.u-tokyo.ac.jp/sk/',
  intervalSec: 10,
};

const fields = [
  { label: 'Run / Subrun', desc: '測定の通し番号（Run）と、その中をさらに区切った番号（Subrun）' },
  { label: 'Event / Event time', desc: 'イベント番号と、そのイベントが起きた時刻（日本時間）' },
  { label: 'TRG Type(s)', desc: 'どのトリガー（記録の条件）に引っかかったか。LE・HE・SLE はエネルギーの大きさ別、OD は外水槽の反応' },
  { label: 'TotalPE ID/OD', desc: '内水槽 (ID) と外水槽 (OD) で検出された光の総量（光電子数）' },
  { label: 'NumHits ID/OD', desc: '光を検出した光電子増倍管の本数' },
  { label: 'Events scanned', desc: 'モニターがこれまでに処理したイベント数' },
];
---

<Layout
  title={pageTitle('スーパーカミオカンデ リアルタイムモニター')}
  description="スーパーカミオカンデが公開しているイベントディスプレイを、検出器の形に組み立てて表示します。"
>
  <div class="page">
    <Header current="superk" />
    <main>
      <header class="intro">
        <h1>スーパーカミオカンデ リアルタイムモニター</h1>
        <p>神岡の地下 1000m にある検出器が、いま記録したイベントです。10 秒ごとに新しい画像を取りに行きます。</p>
      </header>

      <section
        class="monitor"
        aria-label="イベントディスプレイ"
        data-view="3d"
        style={`--skev: url("${source.image}")`}
      >
        <div class="toolbar">
          <p class="status" aria-live="polite">
            <span class="status-label">最終更新</span>
            <time class="status-time">読み込み中</time>
          </p>
          <div class="controls">
            <div class="segmented" role="group" aria-label="表示方法">
              <button type="button" data-view="3d" aria-pressed="true">円筒</button>
              <button type="button" data-view="2d" aria-pressed="false">展開図</button>
            </div>
            <button type="button" class="toggle" aria-pressed="false">一時停止</button>
          </div>
        </div>

        <div class="window">
          <div class="view-3d">
            <SuperKCylinder />
          </div>
          <a href={source.page} target="_blank" rel="noopener" class="view-2d">
            <img
              id="skev"
              src={source.image}
              data-src={source.image}
              data-interval={source.intervalSec}
              width="1437"
              height="955"
              alt="スーパーカミオカンデの最新イベントディスプレイ"
            />
          </a>
        </div>

        <p class="credit">
          展開図と円筒表示は、<a href={source.home} target="_blank" rel="noopener">東京大学宇宙線研究所 神岡宇宙素粒子研究施設</a>提供のデータ（<a href={source.page} target="_blank" rel="noopener">リアルタイムモニター</a>の画像）を用いています。画像の著作権は同施設にあります。個人の学習を目的とした非公式・非商用のページで、表示内容の正確さは保証されません。
        </p>
      </section>

      <section class="fields-section" aria-labelledby="fields-heading">
        <h2 id="fields-heading">イベント情報の項目</h2>
        <dl class="fields">
          {fields.map(f => (
            <div class="field">
              <dt>{f.label}</dt>
              <dd>{f.desc}</dd>
            </div>
          ))}
        </dl>
      </section>
    </main>
  </div>
</Layout>

<script>
  const monitor = document.querySelector<HTMLElement>('.monitor')!;
  const img = document.getElementById('skev') as HTMLImageElement;
  const status = document.querySelector<HTMLElement>('.status')!;
  const time = document.querySelector<HTMLTimeElement>('.status-time')!;
  const toggle = document.querySelector<HTMLButtonElement>('.toggle')!;

  const base = img.dataset.src!;
  const intervalMs = Number(img.dataset.interval) * 1000;
  let paused = false;
  let timer: number | undefined;

  // 更新した瞬間だけ時刻を琥珀色にして、何が変わったかを示す
  const setStatus = (state: 'live' | 'paused' | 'error' | 'loading', message: string) => {
    status.dataset.state = state;
    time.textContent = message;
    if (state === 'live') {
      time.dateTime = new Date().toISOString();
      time.classList.remove('fresh');
      void time.offsetWidth;
      time.classList.add('fresh');
    }
  };

  // 画像サイズは日によって変わるので、読み込むたびに円筒表示へ知らせる
  const announceSize = (w: number, h: number) => {
    if (!w || !h) return;
    monitor.dataset.skevW = String(w);
    monitor.dataset.skevH = String(h);
    document.dispatchEvent(new CustomEvent('skev:size', { detail: { w, h } }));
  };

  const now = () =>
    new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

  // 新しい画像を裏で読み込んでから差し替える（ちらつき防止）
  const refresh = () => {
    const next = new Image();
    next.onload = () => {
      announceSize(next.naturalWidth, next.naturalHeight);
      img.src = next.src;
      monitor.style.setProperty('--skev', `url("${next.src}")`);
      if (!paused) setStatus('live', now());
    };
    next.onerror = () => setStatus('error', `${now()} に取得できませんでした。10 秒後にもう一度試します`);
    next.src = `${base}?t=${Date.now()}`;
  };

  const schedule = () => {
    clearInterval(timer);
    if (paused || document.hidden) return;
    timer = window.setInterval(refresh, intervalMs);
  };

  if (img.complete && img.naturalWidth > 0) {
    announceSize(img.naturalWidth, img.naturalHeight);
    setStatus('live', now());
  } else {
    img.addEventListener(
      'load',
      () => {
        announceSize(img.naturalWidth, img.naturalHeight);
        setStatus('live', now());
      },
      { once: true },
    );
    img.addEventListener('error', () => setStatus('error', '画像を取得できませんでした。10 秒後にもう一度試します'), { once: true });
  }

  toggle.addEventListener('click', () => {
    paused = !paused;
    toggle.setAttribute('aria-pressed', String(paused));
    toggle.textContent = paused ? '再開' : '一時停止';
    if (paused) {
      setStatus('paused', '止めています');
    } else {
      refresh();
    }
    schedule();
  });

  // 円筒 / 展開図の切り替え
  for (const button of document.querySelectorAll<HTMLButtonElement>('.segmented button')) {
    button.addEventListener('click', () => {
      monitor.dataset.view = button.dataset.view;
      for (const b of document.querySelectorAll<HTMLButtonElement>('.segmented button')) {
        b.setAttribute('aria-pressed', String(b === button));
      }
    });
  }

  // タブが裏にある間は取りに行かない
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && !paused) refresh();
    schedule();
  });

  schedule();
</script>

<style>
  .intro {
    margin-bottom: 2rem;
  }

  .intro p {
    max-width: var(--measure);
  }

  h1 {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .intro p {
    color: var(--ore);
  }

  h2 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  /* 操作列: 左に更新時刻、右に切り替え */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0.75rem;
  }

  .status {
    font-size: 0.9375rem;
    color: var(--ore);
  }

  .status-time {
    margin-left: 0.5em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    transition: color 1.6s ease-out;
  }

  .status-time.fresh {
    color: var(--amber);
    transition: none;
  }

  .status[data-state='error'] .status-time {
    color: var(--amber-text);
  }

  .controls {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .segmented {
    display: flex;
  }

  .segmented button,
  .toggle {
    font-size: 0.875rem;
    padding: 0.3rem 0.9rem;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ore);
    cursor: pointer;
  }

  .segmented button:first-child {
    border-radius: 4px 0 0 4px;
  }

  .segmented button:last-child {
    border-radius: 0 4px 4px 0;
    border-left: 0;
  }

  .toggle {
    border-radius: 4px;
  }

  .segmented button:hover,
  .toggle:hover {
    color: var(--ink);
    border-color: var(--ore);
  }

  .segmented button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* 観測窓: このページで唯一の黒 */
  .window {
    background: var(--window);
    border-radius: 6px;
    overflow: hidden;
  }

  .monitor[data-view='3d'] .view-2d,
  .monitor[data-view='2d'] .view-3d {
    display: none;
  }

  .view-2d img {
    display: block;
    width: 100%;
    height: auto;
  }

  .credit {
    max-width: var(--measure);
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--ore);
  }

  .fields-section {
    max-width: var(--measure);
    margin-top: 3.5rem;
  }

  .fields {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.75rem 1.5rem;
  }

  .field {
    display: contents;
  }

  dt {
    font-weight: 700;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  dd {
    font-size: 0.9375rem;
    color: var(--ore);
  }

  @media (max-width: 560px) {
    .controls {
      margin-left: 0;
    }

    .fields {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }

    dd {
      margin-bottom: 0.75rem;
    }
  }
</style>
