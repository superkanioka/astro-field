---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// サーバー情報はここで一元管理する。変更時はこのブロックだけ直せばよい。
const server = {
  address: 'wap-allan.tun.ply.gg',
  fallbackAddress: 'wap-allan.tun.ply.gg:3459',
  version: '26.3',
};
---

<Layout
  title="Minecraft サーバー — Astro Field"
  description="Astro-field Minecraft サーバーへの接続方法。"
  noindex
>
  <div class="page">
    <div class="glow" aria-hidden="true"></div>
    <Header current="minecraft" />
    <main>
      <header class="intro">
        <h1>Minecraft サーバー</h1>
        <p class="lead">
          Java 版 {server.version}（バニラ）。ホワイトリスト制なので、初回はプレイヤー名を伝えて登録してもらってください。
        </p>
      </header>

      <section class="address-card" aria-labelledby="address-heading">
        <h2 id="address-heading" class="card-label">サーバーアドレス</h2>
        <div class="address-row">
          <code class="address">{server.address}</code>
          <button type="button" class="copy" data-copy={server.address}>コピー</button>
        </div>
        <p class="fallback">
          入れないときの予備:
          <code>{server.fallbackAddress}</code>
          <button type="button" class="copy small" data-copy={server.fallbackAddress}>コピー</button>
        </p>
      </section>

      <section aria-labelledby="steps-heading">
        <h2 id="steps-heading">接続方法</h2>
        <ol class="steps">
          <li>ランチャーで「最新のリリース（{server.version}）」を選んで起動</li>
          <li>「マルチプレイ」→「サーバーを追加」でアドレスを入力して「完了」</li>
          <li>一覧のサーバーを選んで「サーバーに接続」</li>
        </ol>
      </section>
    </main>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach(button => {
    const original = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'コピーしました';
      } catch {
        button.textContent = 'コピーできませんでした';
      }
      setTimeout(() => (button.textContent = original), 2000);
    });
  });
</script>

<style>
  .page {
    min-height: 100vh;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  main {
    max-width: 720px;
    margin: 3rem auto 4rem;
    padding: 0 1rem;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--text), var(--accent-from));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    color: var(--muted);
    line-height: 1.8;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.9em;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1em 0.4em;
    overflow-wrap: anywhere;
  }

  .address-card {
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid rgba(168, 85, 247, 0.35);
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(236, 72, 153, 0.06));
  }

  .card-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .address-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .address {
    font-size: clamp(1.05rem, 4vw, 1.4rem);
    font-weight: 600;
    color: var(--text);
    background: none;
    border: 0;
    padding: 0;
  }

  .copy {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(135deg, var(--accent-from), var(--accent-to));
    border: 0;
    border-radius: var(--radius);
    padding: 0.45rem 1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .copy:hover {
    opacity: 0.85;
  }

  .copy.small {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .fallback {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .steps {
    margin-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #d4d4d8;
    line-height: 1.7;
  }
</style>
