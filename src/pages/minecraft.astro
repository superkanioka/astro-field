---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// サーバー情報はここで一元管理する。変更時はこのブロックだけ直せばよい。
const server = {
  address: 'wap-allan.tun.ply.gg',
  fallbackAddress: 'wap-allan.tun.ply.gg:3459',
  version: '26.3',
};
---

<Layout
  title="マイクラサーバー — Astro Field"
  description="Astro-field Minecraft サーバーへの接続方法。"
  noindex
>
  <div class="page">
    <Header current="minecraft" />
    <main>
      <h1>マイクラサーバー</h1>
      <p class="lead">
        Java 版 {server.version}（バニラ）。ホワイトリスト制なので、初めての人はプレイヤー名を伝えて登録してもらってください。
      </p>

      <section class="address" aria-labelledby="address-heading">
        <h2 id="address-heading">サーバーアドレス</h2>
        <div class="address-row">
          <code class="address-main">{server.address}</code>
          <button type="button" class="copy" data-copy={server.address}>コピー</button>
        </div>
        <p class="fallback">
          入れないときはこちら
          <code>{server.fallbackAddress}</code>
          <button type="button" class="copy small" data-copy={server.fallbackAddress}>コピー</button>
        </p>
      </section>

      <section class="steps-section" aria-labelledby="steps-heading">
        <h2 id="steps-heading">接続方法</h2>
        <ol class="steps">
          <li>ランチャーで「最新のリリース（{server.version}）」を選んで起動</li>
          <li>「マルチプレイ」→「サーバーを追加」でアドレスを入力して「完了」</li>
          <li>一覧のサーバーを選んで「サーバーに接続」</li>
        </ol>
      </section>
    </main>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach(button => {
    const original = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'コピーしました';
      } catch {
        button.textContent = 'コピーできませんでした';
      }
      setTimeout(() => (button.textContent = original), 2000);
    });
  });
</script>

<style>
  /* 左端はヘッダーに揃え、行長だけ詰める */
  main > :global(*) {
    max-width: var(--measure);
  }

  h1 {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .lead {
    color: var(--ore);
  }

  h2 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  code {
    font-family: var(--font-fixed);
  }

  /* このページの主役: 打ち込む文字列そのものを大きく */
  .address {
    margin-top: 2.5rem;
    padding-left: 1.25rem;
    border-left: 4px solid var(--amber);
  }

  .address h2 {
    color: var(--ore);
    font-weight: 400;
    font-size: 0.9375rem;
  }

  .address-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .address-main {
    font-size: clamp(1.375rem, 0.9rem + 2.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .copy {
    font-size: 0.875rem;
    padding: 0.35rem 1rem;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 4px;
    cursor: pointer;
  }

  .copy:hover {
    background: #000;
  }

  .copy.small {
    font-size: 0.8125rem;
    padding: 0.15rem 0.7rem;
    color: var(--ink);
    background: transparent;
    border-color: var(--rule);
  }

  .copy.small:hover {
    border-color: var(--ore);
  }

  .fallback {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: 0.9375rem;
    color: var(--ore);
  }

  .fallback code {
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .steps-section {
    margin-top: 3rem;
  }

  .steps {
    padding-left: 1.5rem;
    display: grid;
    gap: 0.375rem;
  }

  .steps li::marker {
    color: var(--ore);
    font-variant-numeric: tabular-nums;
  }
</style>
